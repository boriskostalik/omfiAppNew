Homestead.json
Homestead.yaml
auth.json

# Logs and debug files
npm-debug.log
yarn-error.log
*.log

# IDE & system files
/.fleet
/.idea
/.vscode

# NPM/Yarn lock súbor (odporúča sa necommitovať, ak používate npm)
package-lock.json

# Konfigurácia pre JavaScript (nepotrebné commitovať, ak to nie je zámer)
jsconfig.json
